{
  "name": "site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Marketing and documentation site (PPDS v1.1) for React PDF Viewer, built with Astro.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --port 4173",
    "typecheck": "astro check",
    "generate-samples": "tsx scripts/generate-samples.ts",
    "e2e": "playwright test --project=chromium --project=firefox --project=webkit",
    "e2e:visual": "bash scripts/visual.sh",
    "e2e:visual:update": "bash scripts/visual.sh --update-snapshots"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/react": "^6.0.5",
    "@kiralygyula92/react-pdf-viewer": "workspace:*",
    "@stackblitz/sdk": "^1.11.1",
    "astro": "^7.3.2",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ppds-kit": "workspace:*"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.23.13",
    "typescript": "~7.0.2",
    "vite-plugin-static-copy": "^4.1.1"
  }
}
