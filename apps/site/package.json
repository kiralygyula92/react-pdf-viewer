{
  "name": "site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Documentation site for React PDF Viewer: a static React site built with Vite.",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "node scripts/build.ts",
    "preview": "node scripts/preview.ts",
    "typecheck": "tsc --noEmit",
    "generate-samples": "tsx scripts/generate-samples.ts",
    "e2e": "playwright test --project=chromium --project=firefox --project=webkit",
    "e2e:visual": "bash scripts/visual.sh",
    "e2e:visual:update": "bash scripts/visual.sh --update-snapshots"
  },
  "dependencies": {
    "@kiralygyula92/react-pdf-viewer": "workspace:*",
    "@stackblitz/sdk": "^1.11.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "pdfjs-dist": "^6.3.289",
    "ppds-kit": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.63.0",
    "@shikijs/rehype": "^4.4.3",
    "@types/hast": "^3.0.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "estree-util-value-to-estree": "^3.5.0",
    "hast-util-to-string": "^3.0.1",
    "pdf-lib": "^1.17.1",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "remark-smartypants": "^3.0.3",
    "shiki": "^4.4.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.3.1",
    "vite-plugin-static-copy": "^4.1.1"
  }
}
