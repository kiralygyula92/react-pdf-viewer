---
/**
 * URL-driven full-page viewer (`?src=&page=&zoom=&rotation=`) for the functional Playwright suites
 * (EXCEPTIONS E-03): no site chrome, noindex, not in nav, sitemap or llms.txt. The public demo is
 * the Playground (DECISIONS D-07).
 */
import ViewerFixture from '../../../islands/ViewerFixture';

export function getStaticPaths() {
  // Astro ignores _-prefixed route folders; a dynamic segment keeps the /_internal/ URL (E-03).
  return [{ params: { internal: '_internal' } }];
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Viewer fixture · React PDF Viewer</title>
  </head>
  <body>
    <div class="demo-root">
      <ViewerFixture client:only="react" />
    </div>
  </body>
</html>
