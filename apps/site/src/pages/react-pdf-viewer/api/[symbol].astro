---
/** Generated reference page (archetype E), one per public symbol (PPDS §6 E, §8.4–8.5). */
import { loadReference, optionsHeading, type NavPage, type ReferenceEntry } from 'ppds-kit';
import DocsLayout from 'ppds-kit/astro/DocsLayout.astro';
import { CONTENT_PATH, CONTENT_ROOT, feeds, getDescriptions, getModel, getPortfolio, pageMeta, PLUGIN_ID, twin } from '../../../lib/site';

export function getStaticPaths() {
  const reference = loadReference(CONTENT_ROOT);
  return [...reference.symbols.values()].map((entry) => ({ params: { symbol: entry.slug }, props: { name: entry.schema.name } }));
}

const model = getModel();
const reference = loadReference(CONTENT_ROOT);
const entry = reference.symbols.get(Astro.props.name) as ReferenceEntry;
const { schema, strings } = entry;
const pathname = `/${PLUGIN_ID}/api/${entry.slug}/`;
const title = `${schema.name} reference`;
const description = (strings.symbolDescription ?? '').replace(/<[^>]+>/g, '');
const page: NavPage = {
  pathname,
  title: schema.name,
  section: 'reference',
  sectionTitle: model.titles[`/${PLUGIN_ID}/api-group`] ?? 'Reference',
  archetype: 'E',
  sourceFile: null,
};
const descriptions = await getDescriptions();
const optionRows = Object.entries(schema.options ?? {});
const eventRows = Object.entries(schema.events ?? {});
const heading = optionsHeading(schema.kind);
const headings = [
  { depth: 2, slug: 'used-by', text: 'Used by' },
  { depth: 2, slug: 'import', text: 'Import' },
  ...(optionRows.length ? [{ depth: 2, slug: 'options', text: heading }] : []),
  ...(eventRows.length ? [{ depth: 2, slug: 'events', text: 'Events' }] : []),
  ...(schema.classes?.length ? [{ depth: 2, slug: 'css-classes', text: 'CSS classes' }] : []),
  { depth: 2, slug: 'source', text: 'Source' },
];
const rows = (entries: [string, (typeof optionRows)[number][1]][], prose: Record<string, string> = {}) =>
  entries.map(([name, option]) => ({ name, option, description: prose[name] ?? '' }));
---

<DocsLayout
  model={model}
  portfolio={getPortfolio()}
  page={page}
  meta={pageMeta(page, title, description)}
  headings={headings}
  descriptions={descriptions}
  generatedFrom={schema.filename}
  twin={twin(pathname)}
  feeds={feeds}
>
  <header class="ppds-article__header">
    <h1 class="ppds-article__title">{title}</h1>
    <p class="ppds-article__subtitle" data-description set:html={strings.symbolDescription ?? ''} />
  </header>
  <div class="ppds-prose ppds-reference" data-kind={schema.kind}>
    <h2 id="used-by">Used by</h2>
    {
      (schema.usedBy ?? []).length ? (
        <ul>
          {(schema.usedBy ?? []).map((usedBy) => (
            <li>
              <a href={usedBy}>{model.byPath.get(usedBy)?.title ?? usedBy}</a>
            </li>
          ))}
        </ul>
      ) : (
        <p data-internal>Internal building block: not documented on a capability page.</p>
      )
    }

    <h2 id="import">Import</h2>
    <pre tabindex="0"><code>{(schema.imports ?? []).join('\n')}</code></pre>
    {schema.signature && (
      <p>
        Signature: <code>{schema.signature}</code>
        {schema.returns && (
          <>
            {' '}→ <code>{schema.returns}</code>
          </>
        )}
      </p>
    )}

    {
      optionRows.length > 0 && (
        <>
          <h2 id="options">{heading}</h2>
          <table>
            <thead>
              <tr>
                <th scope="col">Name</th>
                <th scope="col">Type</th>
                <th scope="col">Default</th>
                <th scope="col">Required</th>
                <th scope="col">Description</th>
              </tr>
            </thead>
            <tbody>
              {rows(optionRows, strings.optionDescriptions).map(({ name, option, description: prose }) => (
                <tr id={`option-${name.replace(/[^A-Za-z0-9-]/g, '-')}`}>
                  <td>
                    <code>{name}</code>
                    {option.deprecated && <em class="ppds-reference__deprecated"> (deprecated)</em>}
                  </td>
                  <td>
                    <code>{option.type.description ?? option.type.name}</code>
                  </td>
                  <td>{option.default === undefined ? '—' : <code>{String(option.default)}</code>}</td>
                  <td>{option.required ? 'Yes' : 'No'}</td>
                  <td set:html={prose} />
                </tr>
              ))}
            </tbody>
          </table>
        </>
      )
    }

    {
      eventRows.length > 0 && (
        <>
          <h2 id="events">Events</h2>
          <table>
            <thead>
              <tr>
                <th scope="col">Name</th>
                <th scope="col">Type</th>
                <th scope="col">Default</th>
                <th scope="col">Required</th>
                <th scope="col">Description</th>
              </tr>
            </thead>
            <tbody>
              {rows(eventRows, strings.eventDescriptions).map(({ name, option, description: prose }) => (
                <tr>
                  <td>
                    <code>{name}</code>
                  </td>
                  <td>
                    <code>{option.type.description ?? option.type.name}</code>
                  </td>
                  <td>—</td>
                  <td>{option.required ? 'Yes' : 'No'}</td>
                  <td set:html={prose} />
                </tr>
              ))}
            </tbody>
          </table>
        </>
      )
    }

    {
      schema.classes && schema.classes.length > 0 && (
        <>
          <h2 id="css-classes">CSS classes</h2>
          <table>
            <thead>
              <tr>
                <th scope="col">Key</th>
                <th scope="col">Class</th>
                <th scope="col">Description</th>
              </tr>
            </thead>
            <tbody>
              {schema.classes.map((item) => (
                <tr>
                  <td>{item.key}</td>
                  <td>
                    <code>{item.className}</code>
                  </td>
                  <td>{strings.classDescriptions?.[item.key]?.description ?? ''}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </>
      )
    }

    <h2 id="source">Source</h2>
    <p><a href={schema.sourceUrl ?? `${model.config.repo}/blob/main/${schema.filename}`}>{schema.filename}</a></p>
    <p class="ppds-reference__note">Generated from <code>{CONTENT_PATH}/reference/{entry.slug}.schema.json</code>. Do not edit by hand.</p>
  </div>
</DocsLayout>
