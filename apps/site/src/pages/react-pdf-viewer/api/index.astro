---
/** Generated API index (archetype K): cards come from the generated reference, never by hand. */
import { KIND_LABEL, loadReference, slugify, type NavPage } from 'ppds-kit';
import CardGrid from 'ppds-kit/astro/CardGrid.astro';
import DocsArticle from 'ppds-kit/astro/DocsArticle.astro';
import DocsLayout from 'ppds-kit/astro/DocsLayout.astro';
import { CONTENT_ROOT, feeds, getDescriptions, getModel, getPortfolio, pageMeta, PLUGIN_ID, twin } from '../../../lib/site';

const model = getModel();
const page = model.byPath.get(`/${PLUGIN_ID}/api/`) as NavPage;
const descriptions = await getDescriptions();
const reference = loadReference(CONTENT_ROOT);
const description = descriptions.get(page.pathname) ?? '';

const groups = new Map<string, { title: string; description?: string | undefined; href: string }[]>();
for (const entry of reference.symbols.values()) {
  const label = KIND_LABEL[entry.schema.kind];
  const list = groups.get(label) ?? [];
  list.push({
    title: entry.schema.name,
    description: entry.strings.symbolDescription?.replace(/<[^>]+>/g, ''),
    href: `/${PLUGIN_ID}/api/${entry.slug}/`,
  });
  groups.set(label, list);
}
const headings = [...groups.keys()].map((text) => ({ depth: 2, slug: slugify(text), text }));
---

<DocsLayout
  model={model}
  portfolio={getPortfolio()}
  page={page}
  meta={pageMeta(page, page.title, description)}
  headings={headings}
  descriptions={descriptions}
  generatedFrom={`${model.config.referenceSource?.entry ?? ''}`}
  twin={twin(page.pathname)}
  feeds={feeds}
>
  <DocsArticle model={model} page={page} description={description} descriptions={descriptions}>
    <p>
      Every page in this section is generated from the TypeScript declarations and TSDoc comments of
      <code>@kiralygyula92/react-pdf-viewer</code>, so it always matches the published types. Capability
      pages explain when to use each symbol; these pages list everything it accepts.
    </p>
    {
      [...groups].map(([title, items]) => (
        <section>
          <h2 id={slugify(title)}>{title}</h2>
          <CardGrid items={items} />
        </section>
      ))
    }
  </DocsArticle>
</DocsLayout>
