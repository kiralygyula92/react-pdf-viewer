{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm --filter @kiralygyula92/react-pdf-viewer build && pnpm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/products/react-pdf-viewer/",
      "destination": "/react-pdf-viewer/",
      "permanent": true
    },
    {
      "source": "/react-pdf-viewer/demos/document-viewer/",
      "destination": "/react-pdf-viewer/demos/playground/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
