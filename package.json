{
  "name": "react-pdf-viewer-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm --filter @kiralygyula92/react-pdf-viewer build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter demo e2e",
    "qa": "pnpm --filter @kiralygyula92/react-pdf-viewer qa",
    "smoke": "node scripts/consumer-smoke.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && prettier --write \"packages/*/CHANGELOG.md\"",
    "release": "pnpm --filter @kiralygyula92/react-pdf-viewer build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.2",
    "eslint": "^10.10.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.70.0"
  }
}
