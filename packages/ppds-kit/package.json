{
  "name": "ppds-kit",
  "version": "0.0.0",
  "private": true,
  "description": "Plugin-agnostic documentation site kit: layouts, page templates, navigation, metadata, generators, reference extraction and the conformance checker.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./components": "./src/components/index.ts",
    "./client/shell": "./src/client/shell.ts",
    "./client/DemoToolbar": "./src/client/DemoToolbar.tsx",
    "./styles/*": "./src/styles/*",
    "./artifacts": "./src/artifacts.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "ppds": "node src/cli.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "pagefind": "^1.5.2",
    "satori": "^0.33.4",
    "typedoc": "^0.28.20",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "typescript": "~6.0.3",
    "react-dom": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
