---
/** `:::info` / `:::warning` callout (PPDS §6 B, J). Anti-patterns pass `wrong` code in the slot. */
interface Props {
  type?: 'info' | 'warning';
  title?: string;
}

const { type = 'info', title } = Astro.props;
---

<aside class={`ppds-callout ppds-callout--${type}`} role="note">
  <p class="ppds-callout__title">{title ?? (type === 'warning' ? 'Warning' : 'Note')}</p>
  <div class="ppds-callout__body"><slot /></div>
</aside>
