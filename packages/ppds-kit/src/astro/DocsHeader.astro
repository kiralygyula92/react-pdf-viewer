---
/**
 * Docs header (PPDS §2.2): logo back to the marketing surface, plugin name, version selector,
 * search, repository link. Never the marketing mega-menus.
 */
import type { PluginConfig, PortfolioConfig } from '../types.ts';
import Search from './Search.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  portfolio: PortfolioConfig;
  config: PluginConfig;
}

const { portfolio, config } = Astro.props;
const versions = config.versions ?? [
  { label: `v${config.currentVersion}`, href: `/${config.id}/`, current: true },
];
---

<header class="ppds-header ppds-header--docs">
  <div class="ppds-header__inner">
    <button
      type="button"
      class="ppds-icon-button ppds-header__menu"
      data-sidebar-toggle
      aria-controls="ppds-sidebar-panel"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M3 6h18v2H3zm0 5h18v2H3zm0 5h18v2H3z"></path></svg>
    </button>
    <a class="ppds-logo" href="/" aria-label={`${portfolio.name} home`}>
      <span class="ppds-logo__mark" aria-hidden="true"></span>
      <span class="ppds-logo__text">{portfolio.name}</span>
    </a>
    <span class="ppds-header__divider" aria-hidden="true">/</span>
    <a class="ppds-header__plugin" href={`/${config.id}/`}>{config.name}</a>
    <label class="ppds-version">
      <span class="ppds-visually-hidden">Documentation version</span>
      <select data-version-select>
        {
          versions.map((version) => (
            <option value={version.href} selected={version.current}>
              {version.label}
            </option>
          ))
        }
      </select>
    </label>
    <div class="ppds-header__spacer"></div>
    <Search pluginId={config.id} version={config.currentVersion} />
    <a class="ppds-icon-button" href={config.repo} rel="noopener" aria-label="Source repository on GitHub">
      <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.46-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.6 9.6 0 0 1 12 6.8c.85 0 1.71.11 2.51.34 1.91-1.3 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"></path></svg>
    </a>
    <ThemeToggle />
  </div>
</header>

<script>
  for (const select of document.querySelectorAll<HTMLSelectElement>('[data-version-select]')) {
    select.addEventListener('change', () => {
      window.location.href = select.value;
    });
  }
</script>
