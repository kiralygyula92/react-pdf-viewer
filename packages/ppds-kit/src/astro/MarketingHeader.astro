---
/**
 * Marketing header (PPDS §2.1): logo, mega-menus whose entries carry their own positioning
 * `{title, oneLineDescription, href}`, flat links, search and repository link.
 */
import type { PortfolioConfig } from '../types.ts';
import ThemeToggle from './ThemeToggle.astro';

export interface MenuEntry {
  title: string;
  description: string;
  href: string;
}

interface Props {
  portfolio: PortfolioConfig;
  menus: { label: string; entries: MenuEntry[] }[];
  links: { title: string; href: string }[];
  repo?: string | undefined;
}

const { portfolio, menus, links, repo } = Astro.props;
---

<header class="ppds-header ppds-header--marketing">
  <div class="ppds-header__inner">
    <a class="ppds-logo" href="/" aria-label={`${portfolio.name} home`}>
      <span class="ppds-logo__mark" aria-hidden="true"></span>
      <span class="ppds-logo__text">{portfolio.name}</span>
    </a>
    <nav class="ppds-mega" aria-label="Main">
      <ul class="ppds-mega__list">
        {
          menus.map((menu, index) => (
            <li class="ppds-mega__item">
              <details class="ppds-mega__details" data-mega>
                <summary class="ppds-mega__trigger" aria-controls={`ppds-mega-${index}`}>
                  {menu.label}
                </summary>
                <ul class="ppds-mega__panel" id={`ppds-mega-${index}`}>
                  {menu.entries.map((entry) => (
                    <li>
                      <a class="ppds-mega__entry" href={entry.href}>
                        <span class="ppds-mega__entry-title">{entry.title}</span>
                        <span class="ppds-mega__entry-description">{entry.description}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          ))
        }
        {
          links.map((link) => (
            <li class="ppds-mega__item">
              <a class="ppds-mega__link" href={link.href}>
                {link.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="ppds-header__spacer"></div>
    {
      repo && (
        <a class="ppds-icon-button" href={repo} rel="noopener" aria-label="Source repository on GitHub">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
            <path fill="currentColor" d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.46-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.6 9.6 0 0 1 12 6.8c.85 0 1.71.11 2.51.34 1.91-1.3 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" />
          </svg>
        </a>
      )
    }
    <ThemeToggle />
  </div>
</header>

<script>
  const menus = [...document.querySelectorAll<HTMLDetailsElement>('[data-mega]')];
  for (const menu of menus) {
    menu.addEventListener('toggle', () => {
      if (menu.open) for (const other of menus) if (other !== menu) other.open = false;
    });
  }
  document.addEventListener('click', (event) => {
    for (const menu of menus) if (!menu.contains(event.target as Node)) menu.open = false;
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    for (const menu of menus) {
      if (menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    }
  });
</script>
