---
/** Marketing surface shell (PPDS §2.1): announcement → header → content → footer. */
import type { PageMeta } from '../surfaces.ts';
import type { PortfolioConfig } from '../types.ts';
import Head from './Head.astro';
import MarketingHeader, { type MenuEntry } from './MarketingHeader.astro';
import SiteFooter from './SiteFooter.astro';
import '../styles/site.css';

interface Props {
  meta: PageMeta;
  portfolio: PortfolioConfig;
  menus: { label: string; entries: MenuEntry[] }[];
  links: { title: string; href: string }[];
  repo?: string | undefined;
  announcement?: { text: string; href: string } | undefined;
  feeds?: { title: string; href: string }[];
}

const { meta, portfolio, menus, links, repo, announcement, feeds } = Astro.props;
---

<!doctype html>
<html lang={meta.language}>
  <head>
    <Head meta={meta} siteName={portfolio.name} />
    <slot name="head" />
  </head>
  <body class="ppds ppds--marketing">
    <a class="ppds-skip-link" href="#main">Skip to content</a>
    {
      announcement && (
        <div class="ppds-announcement" role="region" aria-label="Announcement">
          <a href={announcement.href}>{announcement.text}</a>
        </div>
      )
    }
    <MarketingHeader portfolio={portfolio} menus={menus} links={links} repo={repo} />
    <main id="main" class="ppds-marketing" tabindex="-1">
      <slot />
    </main>
    <SiteFooter portfolio={portfolio} feeds={feeds ?? []} />
  </body>
</html>
