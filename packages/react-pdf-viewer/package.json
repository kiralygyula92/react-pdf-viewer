{
  "name": "@kiralygyula92/react-pdf-viewer",
  "version": "0.0.0",
  "description": "Accessible, themeable React PDF viewer built on PDF.js: zoom, rotation, fullscreen, search, thumbnails, download and print, with no UI-kit dependency.",
  "keywords": [
    "react",
    "pdf",
    "pdf-viewer",
    "pdfjs",
    "pdf.js",
    "pdfjs-dist",
    "viewer",
    "document-viewer",
    "accessible",
    "a11y",
    "ssr"
  ],
  "license": "MIT",
  "author": "kiralygyula92 (https://github.com/kiralygyula92)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiralygyula92/react-pdf-viewer.git",
    "directory": "packages/react-pdf-viewer"
  },
  "homepage": "https://react-pdf-viewer-chi.vercel.app/react-pdf-viewer/",
  "bugs": {
    "url": "https://github.com/kiralygyula92/react-pdf-viewer/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "vite build",
    "prepack": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa": "publint --strict && attw --pack . --profile esm-only --exclude-entrypoints ./styles.css && size-limit"
  },
  "peerDependencies": {
    "pdfjs-dist": "^6.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "pdfjs-dist": "^6.3.289",
    "publint": "^0.3.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "size-limit": "^13.0.3",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "size-limit": [
    {
      "name": "main entry (excluding peer dependencies)",
      "path": "dist/index.js",
      "limit": "20 kB",
      "ignore": [
        "react",
        "react-dom",
        "pdfjs-dist"
      ]
    }
  ]
}
